{
  "expo": {
    "name": "My Notes",
    "slug": "secure-reporter-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "securereporterapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blueteamafrica.securereporterapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F1E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.blueteamafrica.securereporterapp",
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F1E8",
          "dark": {
            "backgroundColor": "#F5F1E8"
          }
        }
      ],
      "expo-secure-store",
      "react-native-quick-crypto",
      "expo-updates",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/cairo/400Regular/Cairo_400Regular.ttf",
            "node_modules/@expo-google-fonts/cairo/500Medium/Cairo_500Medium.ttf",
            "node_modules/@expo-google-fonts/cairo/600SemiBold/Cairo_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/cairo/700Bold/Cairo_700Bold.ttf"
          ]
        }
      ],
      "expo-system-ui"
    ],
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "96fa73ab-18a3-4292-a919-41f3a9193fc3"
      }
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F5F1E8"
    },
    "backgroundColor": "#F5F1E8"
  }
}
